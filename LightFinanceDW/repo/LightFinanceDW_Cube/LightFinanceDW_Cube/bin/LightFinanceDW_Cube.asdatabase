      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
La commande CALCULATE contrôle l'agrégation des cellules feuilles dans le cube.
Si la commande CALCULATE est supprimée ou modifiée, les données au sein du cube sont affectées.
Vous devez modifier cette commande uniquement si vous spécifiez manuellement la façon dont le cube est agrégé.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Budget Variance %]
 AS IIF([Measures].[Budget Amount] = 0, NULL, [Measures].[Budget Variance] / [Measures].[Budget Amount]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Budget Variance]
 AS IIF(IsEmpty([Measures].[Budget Amount]), NULL,
    [Measures].[Actual Amount] - [Measures].[Budget Amount]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Budget Amount]
 AS ([Measures].[Amount], [Scenario].[Scenario].[Budget]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Amount]
 AS ([Measures].[Amount], [Scenario].[Scenario].[Actual]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
