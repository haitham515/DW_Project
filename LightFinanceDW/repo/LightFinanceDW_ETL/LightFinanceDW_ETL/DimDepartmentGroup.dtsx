      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B2421CC9-8F76-43DA-9FCF-EE599FD72F24}"
          SQLTask:SqlStatementSource="UPDATE g SET ParentDepartmentGroupKey = c.DepartmentGroupKey&#xA;FROM dbo.DimDepartmentGroup g&#xA;CROSS JOIN (SELECT DepartmentGroupKey FROM dbo.DimDepartmentGroup&#xA;            WHERE DepartmentGroupName = N'Corporate') c&#xA;WHERE g.DepartmentGroupName &lt;&gt; N'Corporate' AND g.ParentDepartmentGroupKey IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
