      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B2421CC9-8F76-43DA-9FCF-EE599FD72F24}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dbo.DimDepartmentGroup WHERE DepartmentGroupName = N'Corporate')&#xA;    INSERT INTO dbo.DimDepartmentGroup (ParentDepartmentGroupKey, DepartmentGroupName)&#xA;    VALUES (NULL, N'Corporate');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
