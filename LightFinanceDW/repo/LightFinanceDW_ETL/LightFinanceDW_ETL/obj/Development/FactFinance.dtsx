                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT f.DateKey,
       o.OrganizationKey,
       dg.DepartmentGroupKey,
       s.ScenarioKey,
       a.AccountKey,
       f.Amount,
       f.[Date]
FROM AdventureWorksDW2025.dbo.FactFinance f
JOIN AdventureWorksDW2025.dbo.DimAccount         sa  ON sa.AccountKey = f.AccountKey
JOIN LightFinanceDW.dbo.DimAccount               a   ON a.AccountCodeAlternateKey = sa.AccountCodeAlternateKey
JOIN AdventureWorksDW2025.dbo.DimScenario        ss  ON ss.ScenarioKey = f.ScenarioKey
JOIN LightFinanceDW.dbo.DimScenario              s   ON s.ScenarioName = ss.ScenarioName
JOIN AdventureWorksDW2025.dbo.DimDepartmentGroup sdg ON sdg.DepartmentGroupKey = f.DepartmentGroupKey
JOIN LightFinanceDW.dbo.DimDepartmentGroup       dg  ON dg.DepartmentGroupName = sdg.DepartmentGroupName
JOIN LightFinanceDW.dbo.DimDate                  d   ON d.DateKey = f.DateKey
JOIN LightFinanceDW.dbo.DimOrganization          o   ON o.OrganizationAlternateKey = f.OrganizationKey
                                                    AND d.FullDateAlternateKey &gt;= o.StartDate
                                                    AND d.FullDateAlternateKey &lt;  ISNULL(o.EndDate, '99991231')
WHERE f.DateKey &gt; ?</property>
                <property
                  dataType="System.String"
                  description="Variable contenant la commande SQL à exécuter."
                  name="SqlCommandVariable"></property>
                <property
