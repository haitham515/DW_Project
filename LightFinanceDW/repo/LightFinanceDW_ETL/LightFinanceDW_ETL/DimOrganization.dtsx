    <DTS:Executable
      DTS:refId="Package\Resolve parent organizations"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{81812FAA-0FB8-4BFB-BA8B-E60CDDBED743}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Resolve parent organizations"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B2421CC9-8F76-43DA-9FCF-EE599FD72F24}"
          SQLTask:SqlStatementSource="UPDATE c SET ParentOrganizationKey = p.OrganizationKey&#xA;FROM dbo.DimOrganization c&#xA;LEFT JOIN dbo.DimOrganization p&#xA;       ON p.OrganizationAlternateKey = c.ParentOrganizationAlternateKey&#xA;      AND p.EndDate IS NULL&#xA;WHERE ISNULL(c.ParentOrganizationKey, -1) &lt;&gt; ISNULL(p.OrganizationKey, -1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Set initial validity date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{3BCD5307-3EF1-4B44-8C2D-1DC59220179E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Set initial validity date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B2421CC9-8F76-43DA-9FCF-EE599FD72F24}"
          SQLTask:SqlStatementSource="UPDATE o SET StartDate = '20100701'&#xA;FROM dbo.DimOrganization o&#xA;WHERE o.StartDate &lt;&gt; '20100701'&#xA;  AND NOT EXISTS (SELECT 1 FROM dbo.DimOrganization older&#xA;                  WHERE older.OrganizationAlternateKey = o.OrganizationAlternateKey&#xA;                    AND older.OrganizationKey &lt; o.OrganizationKey);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
